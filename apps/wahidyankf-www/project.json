{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "wahidyankf-www",
  "projectType": "application",
  "root": "apps/wahidyankf-www",
  "targets": {
    "build": {
      "command": "next build",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/.next"]
    },
    "dev": {
      "command": "node ../../scripts/next-with-port.mjs dev --env WAHIDYANKF_WWW_PORT --default 3201",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "start": {
      "command": "node ../../scripts/next-with-port.mjs start --env WAHIDYANKF_WWW_PORT --default 3201",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:lint:biome",
          "npm exec nx -- run wahidyankf-www:lint:commentary"
        ],
        "parallel": false
      }
    },
    "lint:biome": {
      "command": "biome check",
      "options": { "cwd": "{projectRoot}" },
      "cache": true
    },
    "lint:commentary": {
      "command": "eslint --config eslint.config.mjs src",
      "options": { "cwd": "{projectRoot}" },
      "cache": true
    },
    "test:unit": {
      "command": "vitest run --project unit",
      "options": { "cwd": "{projectRoot}" },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs"
      ]
    },
    "test:integration": {
      "command": "vitest run --project integration",
      "options": { "cwd": "{projectRoot}" },
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs"
      ]
    },
    "test:coverage:unit": {
      "command": "vitest run --project unit --project behaviour-unit --coverage --coverage.thresholds.lines=99",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/coverage"],
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs"
      ]
    },
    "test:coverage:integration": {
      "command": "vitest run --project integration --coverage --coverage.include='src/features/cv/**/pdf.ts' --coverage.thresholds.lines=99",
      "options": { "cwd": "{projectRoot}" },
      "cache": false,
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs"
      ]
    },
    "test:coverage:behaviour:wahidyankf-www": {
      "command": "vitest run --project behaviour-unit",
      "options": { "cwd": "{projectRoot}" },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs"
      ]
    },
    "test:coverage:behaviour": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:test:coverage:behaviour:wahidyankf-www",
          "npm exec nx -- run wahidyankf-www-e2e:test:coverage:behaviour:e2e"
        ],
        "parallel": false
      },
      "cache": true,
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs",
        "{workspaceRoot}/apps/wahidyankf-www-e2e/**/*"
      ]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:test:coverage:unit",
          "npm exec nx -- run wahidyankf-www:test:coverage:integration",
          "npm exec nx -- run wahidyankf-www:test:coverage:behaviour"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs",
        "{workspaceRoot}/apps/wahidyankf-www-e2e/**/*"
      ]
    },
    "static-routes:validation": {
      "command": "npm exec nx -- run wahidyankf-www:build --skip-nx-cache && node scripts/validate-static-routes.mjs",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "dependsOn": ["static-routes:validation"],
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:typecheck",
          "npm exec nx -- run wahidyankf-www:lint",
          "npm exec nx -- run wahidyankf-www:test:unit",
          "npm exec nx -- run wahidyankf-www:test:coverage:unit",
          "npm exec nx -- run wahidyankf-www:test:coverage:behaviour"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behaviours/**/*.feature",
        "{workspaceRoot}/scripts/next-with-port.mjs",
        "{workspaceRoot}/apps/wahidyankf-www-e2e/**/*"
      ]
    },
    "generate:cv-pdf": {
      "command": "npx tsx scripts/generate-cv-pdf.ts",
      "options": { "cwd": "{projectRoot}" },
      "cache": false
    }
  },
  "tags": []
}
