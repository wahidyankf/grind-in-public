{
  "name": "wahidyankf-www",
  "projectType": "application",
  "root": "apps/wahidyankf-www",
  "sourceRoot": "apps/wahidyankf-www/src",
  "namedInputs": {
    "behaviorCorpus": [
      "{workspaceRoot}/specs/apps/wahidyankf-www/behavior/**/*.feature"
    ],
    "workspaceScripts": ["{workspaceRoot}/scripts/next-with-port.mjs"]
  },
  "targets": {
    "build": {
      "command": "next build",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/.next"]
    },
    "dev": {
      "cache": false,
      "command": "node ../../scripts/next-with-port.mjs dev --env WAHIDYANKF_WWW_PORT --default 3201",
      "options": { "cwd": "{projectRoot}" }
    },
    "start": {
      "cache": false,
      "command": "node ../../scripts/next-with-port.mjs start --env WAHIDYANKF_WWW_PORT --default 3201",
      "options": { "cwd": "{projectRoot}" }
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:lint:biome",
          "npm exec nx -- run wahidyankf-www:lint:commentary"
        ],
        "parallel": false
      }
    },
    "lint:biome": {
      "cache": true,
      "command": "biome check",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint:commentary": {
      "cache": true,
      "command": "eslint --config eslint.config.mjs src",
      "options": { "cwd": "{projectRoot}" }
    },
    "test:unit": {
      "command": "vitest run --project unit",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["default", "behaviorCorpus", "workspaceScripts"]
    },
    "test:integration": {
      "cache": false,
      "command": "vitest run --project integration",
      "options": { "cwd": "{projectRoot}" }
    },
    "test:coverage:unit": {
      "cache": true,
      "command": "vitest run --project unit --project behavior --coverage --coverage.thresholds.lines=99",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/coverage"],
      "inputs": ["default", "behaviorCorpus", "workspaceScripts"]
    },
    "test:coverage:integration": {
      "cache": false,
      "command": "vitest run --project integration --coverage --coverage.include='src/features/cv/**/pdf.ts' --coverage.thresholds.lines=99",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/coverage"]
    },
    "test:coverage:behavior": {
      "cache": false,
      "command": "vitest run --project behavior",
      "options": { "cwd": "{projectRoot}" },
      "inputs": ["default", "behaviorCorpus", "workspaceScripts"]
    },
    "test:coverage": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:test:coverage:unit",
          "npm exec nx -- run wahidyankf-www:test:coverage:integration",
          "npm exec nx -- run wahidyankf-www:test:coverage:behavior"
        ],
        "parallel": false
      },
      "inputs": ["default", "behaviorCorpus", "workspaceScripts"]
    },
    "static-routes:validation": {
      "cache": false,
      "command": "npm exec nx -- run wahidyankf-www:build --skip-nx-cache && node apps/wahidyankf-www/scripts/validate-static-routes.mjs",
      "options": { "cwd": "{workspaceRoot}" }
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "dependsOn": ["static-routes:validation"],
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www:typecheck",
          "npm exec nx -- run wahidyankf-www:lint",
          "npm exec nx -- run wahidyankf-www:test:unit",
          "npm exec nx -- run wahidyankf-www:test:coverage:unit",
          "npm exec nx -- run wahidyankf-www:test:coverage:behavior"
        ],
        "parallel": false
      },
      "inputs": ["default", "behaviorCorpus", "workspaceScripts"]
    },
    "generate:cv-pdf": {
      "cache": false,
      "command": "npx tsx scripts/generate-cv-pdf.ts",
      "options": { "cwd": "{projectRoot}" },
      "outputs": ["{projectRoot}/public/wahidyankf-kresna-fridayoka-cv.pdf"]
    }
  }
}
