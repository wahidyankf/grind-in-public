@baseUrl = http://localhost:8100

### Health check (FastAPI, run with `npx nx dev edutech-be`)
GET {{baseUrl}}/health

### Backend: register (creates the user; same response if the email exists)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "correct horse"
}

### Backend: login (run this first; the requests below use its tokens)
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "correct horse"
}

> {%
  var body = typeof response.body === "string" ? JSON.parse(response.body) : response.body;
  client.global.set("access_token", body.access_token);
  client.global.set("refresh_token", body.refresh_token);
%}

### Backend: current user
GET {{baseUrl}}/auth/me
Authorization: Bearer {{access_token}}

### Backend: refresh access token
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

### Backend: logout (revokes both tokens from login)
POST {{baseUrl}}/auth/logout
Authorization: Bearer {{access_token}}
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}
