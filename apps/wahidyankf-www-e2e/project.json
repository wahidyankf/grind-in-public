{
  "name": "wahidyankf-www-e2e",
  "projectType": "application",
  "root": "apps/wahidyankf-www-e2e",
  "sourceRoot": "apps/wahidyankf-www-e2e/steps",
  "implicitDependencies": ["wahidyankf-www"],
  "targets": {
    "install": {
      "cache": false,
      "command": "npx playwright install --with-deps chromium",
      "options": { "cwd": "{projectRoot}" },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behavior/**/*.feature"
      ]
    },
    "typecheck": {
      "command": "tsc --noEmit",
      "options": { "cwd": "{projectRoot}" },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behavior/**/*.feature"
      ]
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "npm exec nx -- run wahidyankf-www-e2e:lint:biome",
          "npm exec nx -- run wahidyankf-www-e2e:lint:commentary"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behavior/**/*.feature"
      ]
    },
    "lint:biome": {
      "cache": true,
      "command": "biome check",
      "options": { "cwd": "{projectRoot}" }
    },
    "lint:commentary": {
      "cache": true,
      "command": "eslint --config eslint.config.mjs steps",
      "options": { "cwd": "{projectRoot}" }
    },
    "test:e2e": {
      "cache": false,
      "dependsOn": ["wahidyankf-www:build"],
      "command": "if grep -rn -E --include='*.ts' --exclude-dir=node_modules --exclude-dir=.features-gen --exclude-dir=test-results --exclude-dir=playwright-report '\\$?test\\.skip\\([^,)]*\\)' .; then echo 'ERROR: unconditional test.skip() found in test files above - use test.skip(condition, reason) for legitimate environment guards, or remove'; exit 1; fi && npx bddgen && npx playwright test",
      "options": { "cwd": "{projectRoot}" },
      "inputs": [
        "default",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behavior/**/*.feature"
      ]
    },
    "specs:e2e:baseline": {
      "cache": true,
      "command": "npx bddgen && expected=$(node -e \"process.stdout.write(String(require('./e2e-skip-baseline.json').skippedScenarios))\") && actual=$(grep -rho 'test\\.fixme(' .features-gen | wc -l | tr -d ' ') && if [ \"$actual\" != \"$expected\" ]; then echo \"e2e skip baseline moved: expected $expected fixme scenarios, found $actual\"; exit 1; fi",
      "options": { "cwd": "{projectRoot}" },
      "inputs": [
        "default",
        "{projectRoot}/e2e-skip-baseline.json",
        "{projectRoot}/steps/**/*.ts",
        "{projectRoot}/playwright.config.ts",
        "{workspaceRoot}/specs/apps/wahidyankf-www/behavior/**/*.feature"
      ]
    }
  }
}
