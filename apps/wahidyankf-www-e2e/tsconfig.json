{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["node", "@playwright/test"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "target": "ES2022"
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "tools/**/*.ts"],
  "exclude": [
    "node_modules",
    ".features-gen",
    "playwright-report",
    "test-results"
  ]
}
