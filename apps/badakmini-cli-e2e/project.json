{
  "name": "badakmini-cli-e2e",
  "projectType": "application",
  "root": "apps/badakmini-cli-e2e",
  "sourceRoot": "apps/badakmini-cli-e2e",
  "implicitDependencies": ["badakmini-cli"],
  "targets": {
    "typecheck": {
      "command": "go -C apps/badakmini-cli-e2e vet ./...",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/specs/apps/badakmini-cli/behavior/**/*.feature"
      ]
    },
    "lint": {
      "command": "go -C apps/badakmini-cli-e2e tool golangci-lint run",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/specs/apps/badakmini-cli/behavior/**/*.feature"
      ]
    },
    "test:coverage:behavior": {
      "cache": false,
      "command": "npm exec nx -- run badakmini-cli:test:coverage:behavior",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/specs/apps/badakmini-cli/behavior/**/*.feature"
      ]
    },
    "test:e2e": {
      "cache": false,
      "command": "BADAKMINI_BIN=\"$PWD/apps/badakmini-cli/dist/badak-mini\" go -C apps/badakmini-cli-e2e test -count=1 ./tests",
      "dependsOn": ["^build", "test:coverage:behavior"],
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/specs/apps/badakmini-cli/behavior/**/*.feature"
      ]
    },
    "test:quick": {
      "executor": "nx:run-commands",
      "dependsOn": [
        {
          "projects": ["badakmini-cli"],
          "target": "test:quick"
        }
      ],
      "options": {
        "commands": [
          "npm exec nx -- run badakmini-cli-e2e:typecheck",
          "npm exec nx -- run badakmini-cli-e2e:lint"
        ],
        "parallel": false
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/specs/apps/badakmini-cli/behavior/**/*.feature"
      ]
    }
  }
}
