# Format staged files and screen them before anything is recorded. The surface
# declares the order: the safety gate runs before the formatter, so a staged
# leak is refused rather than tidied.
./rhino gate run --surface pre-commit

# Automatically trigger Rules Propagation whenever the staged change touches a
# rule. This runs for every editor and agent, so the workflow does not depend on
# anyone remembering it. It reports and never blocks: a hook cannot judge
# semantic decisions, only that the procedure applies.
npm exec nx -- run badakmini-cli:rule-change
