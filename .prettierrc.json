{
  "proseWrap": "always",
  "printWidth": 120,
  "overrides": [
    {
      "files": [
        "*.ts",
        "*.tsx",
        "*.js",
        "*.cjs",
        "*.mjs",
        "*.json",
        "*.jsonc",
        "*.css",
        "*.scss",
        "*.yaml",
        "*.yml",
        "*.html"
      ],
      "options": {
        "printWidth": 80
      }
    }
  ]
}
