// Markdown is read in terminal editors without a renderer, so this config
// enforces only the 120-column line limit; Prettier owns every other layout
// choice. The exemptions and their reasons are in
// repo-governance/conventions/markdown-style-policy.md.
{
  "config": {
    "default": false,
    "MD013": {
      "line_length": 120,
      "heading_line_length": 120,
      "code_block_line_length": 120,
      "code_blocks": true,
      "tables": true,
      "headings": true,
      "strict": true,
    },
  },
  "gitignore": true,
  "globs": ["**/*.md"],
  "ignores": [
    "**/node_modules/**",
    "worktrees/**",
    "plans/done/**",
    "specs/fixtures/**",
    "apps/wahidyankf-www/docs/cv-raw.md",
    "apps/wahidyankf-www/docs/cv-linkedin.md",
    "apps/wahidyankf-www/docs/linkedin-projects.md",
  ],
}
