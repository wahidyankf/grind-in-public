node_modules/
.nx/
apps/*/dist/
libs/*/dist/
.memsearch/
# Untracked working area: gate logs and other machine-local records.
local-tmp/
# Optional machine policy for the checksum-pinned HIPPO.
hippo.local.json
# Personal harness overrides: never repository rules.
.claude/settings.local.json
# Generated by the TypeScript app and its E2E suite. These are at the root and
# not only in each project, because Prettier resolves ignore patterns from the
# root .gitignore and a root .prettierignore alone, never from a nested one, so
# a project-local rule would keep `git status` clean and still let
# `npm run format:check` walk thousands of build artifacts.
*.tsbuildinfo
.next/
# Rewritten by Next.js on every run, and to a different path by `next dev` than
# by `next build`, so tracking it makes the working tree dirty after whichever
# command ran last. Regenerated on demand, including on the Vercel build.
apps/*/next-env.d.ts
coverage/
test-results/
playwright-report/
.features-gen/
