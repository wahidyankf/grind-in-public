node_modules/
/worktrees/
.nx/
apps/*/dist/
libs/*/dist/
# Untracked working area: gate logs and other machine-local records — keep dir,
# ignore contents.
local-tmp/*
!local-tmp/.gitkeep
# Requested generated audits and reports are evidence, never authoritative source.
# `**/` is load-bearing: a pattern containing a non-trailing slash is anchored to
# this file's directory, so `generated-reports/*` alone would leave a nested
# apps/<x>/generated-reports/ entirely untracked-and-visible. Matching contents
# rather than the directory itself (`/*`, not `/`) is also load-bearing: git
# cannot re-include a file whose parent directory is excluded.
**/generated-reports/*
!**/generated-reports/.gitkeep
# Real environment files hold local secrets that exist nowhere else, so none is committed.
.env
.env.*
# Generated by the TypeScript app and its E2E suite. These are at the root and
# not only in each project, because Prettier resolves ignore patterns from the
# root .gitignore and a root .prettierignore alone, never from a nested one, so
# a project-local rule would keep `git status` clean and still let
# `npm run format:check` walk thousands of build artifacts.
*.tsbuildinfo
.next/
# Rewritten by Next.js on every run, and to a different path by `next dev` than
# by `next build`, so tracking it makes the working tree dirty after whichever
# command ran last. Regenerated on demand, including on the Vercel build.
apps/*/next-env.d.ts
coverage/
.vitest/
test-results/
playwright-report/
.features-gen/
# Python: virtualenvs, bytecode, and tool caches. Kept at the root so a Python project added later is covered without
# a project-local rule, and so Prettier never walks installed packages.
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
# Go: compiled binaries, test binaries, and coverage profiles.
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.out
# Track Serena project config; keep caches, memories, logs, and personal state local.
/.serena/*
!/.serena/project.yml
