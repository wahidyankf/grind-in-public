{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commitTrailers": false,
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-hippo-boundary.sh",
            "statusMessage": "Checking HIPPO admission boundary..."
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/check-rule-change.mjs\" hook"
          }
        ]
      }
    ]
  }
}
