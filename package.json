{
  "name": "grind-in-public",
  "version": "1.0.0",
  "description": "Personal lifelong-learning workspace maintained by **Wahidyan Kresna Fridayoka**.",
  "main": "index.js",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "check:go-vulnerabilities": "go -C apps/badakmini-cli/cmd/badak-mini tool govulncheck -scan module",
    "check:governance": "nx run badakmini-cli:governance",
    "check:harness-parity": "nx run badakmini-cli:capability-parity",
    "check:markdown-links": "nx run badakmini-cli:markdown-links",
    "check:rule-change": "nx run badakmini-cli:rule-change",
    "check:workflows": "go -C apps/badakmini-cli tool actionlint \"$PWD\"/.github/workflows/*.yml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "nx run-many -t lint",
    "prepare": "husky",
    "test": "npm run test:quick",
    "test:coverage": "nx run-many -t test:coverage",
    "test:behavior": "nx run-many -t test:coverage:behavior",
    "test:e2e": "nx run-many -t test:e2e",
    "test:integration": "nx run-many -t test:integration",
    "test:scheduled": "nx run badakmini-cli:test:quick && nx run badakmini-cli:test:coverage:integration && nx run badakmini-cli:test:e2e",
    "test:unit": "nx run-many -t test:unit",
    "test:quick": "nx run-many -t test:quick",
    "typecheck": "nx run-many -t typecheck"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wahidyankf/grind-in-public.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wahidyankf/grind-in-public/issues"
  },
  "homepage": "https://github.com/wahidyankf/grind-in-public#readme",
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsdoc": "64.3.2",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "nx": "23.1.1",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx,json,jsonc,css,scss,md,mdx,yaml,yml,html}": "prettier --write"
  }
}
