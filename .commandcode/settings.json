{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(SHELL|READ|READ_MULTI|LIST|WRITE|EDIT|SEARCH|GLOB)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.commandcode/hooks/run-policy-hook.sh\" agent-policy",
            "timeout": 30,
            "failClosed": true
          }
        ]
      },
      {
        "matcher": "^(WRITE|EDIT)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.commandcode/hooks/run-policy-hook.sh\" check-rule-change",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
