{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking HIPPO admission boundary...",
            "command": "\"$(git rev-parse --show-toplevel)\"/.claude/hooks/require-hippo-boundary.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "^(apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "statusMessage": "Checking for a rule change",
            "command": "sh -c 'cd \"$(git rev-parse --show-toplevel)\" && node scripts/check-rule-change.mjs hook'"
          }
        ]
      }
    ]
  }
}
