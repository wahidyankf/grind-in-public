{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "npm install*": "deny",
      "rtk npm install*": "deny",
      "npm ci*": "deny",
      "rtk npm ci*": "deny",
      "npm exec*": "deny",
      "rtk npm exec*": "deny",
      "npx *": "deny",
      "rtk npx *": "deny",
      "nx run*": "deny",
      "rtk nx run*": "deny",
      "nx affected*": "deny",
      "rtk nx affected*": "deny",
      "*./hippo run*": "allow"
    }
  }
}
